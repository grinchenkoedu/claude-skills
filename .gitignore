.DS_Store
.idea/
.claude/repo-profile.json

# scratch reports written by the skills — working notes, not history
.gku/

# the root names older installed copies of the plugin still write
SELF_REVIEW.md
REVIEW.md
VERIFY.md
PR_REVIEW_*.md

# plans written by /gku:plan — working notes, not history
.tasks/

# what `claude plugin eval` writes when no --output-dir is given
evals/live/results/
# a case that replays a transcript (context.history_file) gets the resumed session's own log
# written beside it, named by session id and carrying the account's email and home paths;
# history.jsonl is the fixture a case names on purpose, everything else there is harness output
evals/live/*/*.jsonl
!evals/live/*/history.jsonl
